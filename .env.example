# StudyOS Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Settings
PROJECT_NAME="StudyOS"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000

# Security & Local Network
LAN_SECRET="studyos-local-secret"

# Optional AI API Keys (for JARVIS LLM processing; offline parser active if blank)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional Custom Database Path (defaults to data/database/studyos.db)
# DATABASE_PATH="data/database/studyos.db"
